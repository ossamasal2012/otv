<?xml version="1.0" encoding="utf-8"?>
<!--
    واجهة المشغل الداخلي المخصّصة بالكامل — لا تُستخدم عناصر تحكّم PlayerView/VLC الجاهزة
    إطلاقاً؛ كل عنصر هنا مبني يدوياً ليعمل بنفس الشكل تماماً بغض النظر عن محرّك التشغيل
    المُختار (ExoPlayer أو VLC)، ويُتحكّم بكل شيء برمجياً من InternalPlayerActivity.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- طبقة عرض الفيديو نفسها — يُلحق بها المحرّك المُختار (PlayerView أو VLCVideoLayout) برمجياً -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- طبقة شفافة تغطي كامل الشاشة لالتقاط لمسة إظهار/إخفاء عناصر التحكّم -->
    <View
        android:id="@+id/tapCatcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- طبقة التحميل -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000">
        <ProgressBar
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:indeterminateTint="#10B981" />
    </FrameLayout>

    <!-- طبقة الخطأ -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تعذر تشغيل هذا المحتوى."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/errorRetryBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="إعادة المحاولة"
                android:textColor="#052E21"
                android:backgroundTint="#10B981"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/errorBackBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="رجوع"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1E293B" />
        </LinearLayout>
    </LinearLayout>

    <!-- مجموعة عناصر التحكّم (تُخفى/تُظهر معاً عند اللمس) -->
    <FrameLayout
        android:id="@+id/controlsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- الشريط العلوي: رجوع + العنوان + شارة مباشر -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="6dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="26dp"
            android:background="@drawable/player_top_scrim">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_player_back"
                android:contentDescription="رجوع" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="" />

            <TextView
                android:id="@+id/liveBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 مباشر"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/player_live_badge_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- منتصف الشاشة: ترجيع 10 ثوانٍ / تشغيل-إيقاف / تقديم 10 ثوانٍ -->
        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/rewindBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/player_play_pause_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="⟲10"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/playPauseBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:background="@drawable/player_play_pause_bg">
                <ImageView
                    android:id="@+id/playPauseIcon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_player_play"
                    android:contentDescription="تشغيل" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/forwardBtn"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/player_play_pause_bg">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="10⟳"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- الشريط السفلي: الوقت الحالي + شريط التقدّم + المدة الكلية (يُخفى بالبث المباشر) -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="26dp"
            android:paddingBottom="14dp"
            android:background="@drawable/player_bottom_scrim">

            <TextView
                android:id="@+id/currentTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="42dp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="1000"
                android:progressTint="#10B981"
                android:progressBackgroundTint="#4DFFFFFF"
                android:thumbTint="#10B981" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:minWidth="42dp" />
        </LinearLayout>

    </FrameLayout>

</FrameLayout>
